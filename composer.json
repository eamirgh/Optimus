{
    "name": "eamirgh/optimus",
    "description": "High-performance image and asset optimization engine for Laravel",
    "keywords": ["laravel", "image", "optimus", "performance", "webp", "avif", "blade", "srcset", "imgproxy", "cloudinary"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Eamirgh\\Optimus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eamirgh\\Optimus\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Eamirgh\\Optimus\\OptimusServiceProvider"
            ],
            "aliases": {
                "Optimus": "Eamirgh\\Optimus\\Facades\\Optimus"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
